{
	"name": "clean-google-photos",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm package:extension && vite dev --host 127.0.0.1 --port 5178 --strictPort",
		"build": "pnpm package:extension && vite build",
		"preview": "vite preview --host 127.0.0.1 --port 5178 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "pnpm preview",
		"test": "vitest run --config vitest.config.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:pages": "BASE_PATH=/photos-sifter pnpm build",
		"package:extension": "node scripts/package-extension.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.42.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "latest",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.5.0",
		"@types/wicg-file-system-access": "^2023.10.7",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"fake-indexeddb": "^6.2.5",
		"fflate": "^0.8.3",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
	"dependencies": {
		"dexie": "^4.4.5",
		"zod": "^4.5.4"
	},
	"engines": {
		"node": ">=22.13"
	}
}
